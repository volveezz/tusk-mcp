{
  "name": "tusk-mcp",
  "version": "0.3.0",
  "description": "PostgreSQL MCP server for AI agents. Schema introspection, SELECT-only query execution, and opt-in write access per target.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/volveezz/tusk-mcp.git"
  },
  "homepage": "https://github.com/volveezz/tusk-mcp",
  "bugs": {
    "url": "https://github.com/volveezz/tusk-mcp/issues"
  },
  "keywords": [
    "mcp",
    "postgresql",
    "postgres",
    "ai",
    "agent",
    "model-context-protocol",
    "database",
    "schema",
    "read-only",
    "sql"
  ],
  "bin": {
    "tusk-mcp": "dist/cli.mjs"
  },
  "files": [
    "dist/cli.mjs"
  ],
  "engines": {
    "node": ">=18.3.0"
  },
  "scripts": {
    "dev": "bun run src/index.ts",
    "check": "tsc --noEmit && bun test",
    "test": "bun test",
    "build:npm": "bun build src/index.ts --outfile dist/cli.mjs --target=node --minify --external cpu-features",
    "prepublishOnly": "bun run build:npm",
    "build": "bun build --compile --bytecode --minify --format=esm --splitting src/index.ts --outfile dist/tusk-mcp"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@types/node": "^22.20.5",
    "@types/ssh2": "^1.15.6",
    "bun-types": "^1.4.5",
    "postgres": "^3.4.9",
    "ssh2": "^1.17.0",
    "typescript": "^5.9.3",
    "zod": "^4.6.7"
  }
}
